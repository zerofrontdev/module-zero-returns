{
    "name": "zerofront/module-zero-returns",
    "description": "Zero for Magento Open Source: returns (RMA): the customer asks from My Account, the store approves, receives and refunds in Sales > Returns, with messages and emails.",
    "type": "magento2-module",
    "version": "1.3.5",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "returns",
        "rma"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-customer": "*",
        "magento/module-email": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "zerofront/module-zero-core": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-returns": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\Returns\\": ""
        }
    }
}
